t;/span&gt;())&lt;br&gt;                    )&lt;br&gt;&lt;br&gt;                    &lt;span style=&quot;color:#7a7e85;&quot;&gt;// Logic to extract values for visualization&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#7a7e85;&quot;&gt;                    &lt;/span&gt;&lt;span style=&quot;color:#cf8e6d;&quot;&gt;val &lt;/span&gt;linearX = linearText.&lt;span style=&quot;color:#57aaf7;font-style:italic;&quot;&gt;substringAfter&lt;/span&gt;(&lt;span style=&quot;color:#6aab73;&quot;&gt;&quot;Acc: X=&quot;&lt;/span&gt;).&lt;span style=&quot;color:#57aaf7;font-style:italic;&quot;&gt;substringBefore&lt;/span&gt;(&lt;span style=&quot;color:#6aab73;&quot;&gt;&quot;,&quot;&lt;/span&gt;).&lt;span style=&quot;color:#57aaf7;font-style:italic;&quot;&gt;toFloatOrNull&lt;/span&gt;() ?: &lt;span style=&quot;color:#2aacb8;&quot;&gt;0f&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#2aacb8;&quot;&gt;                    &lt;/span&gt;&lt;span style=&quot;color:#cf8e6d;&quot;&gt;val &lt;/span&gt;linearY = linearText.&lt;span style=&quot;color:#57aaf7;font-style:italic;&quot;&gt;substringAfter&lt;/span&gt;(&lt;span style=&quot;color:#6aab73;&quot;&gt;&quot;Y=&quot;&lt;/span&gt;).&lt;span style=&quot;color:#57aaf7;font-style:italic;&quot;&gt;substringBefore&lt;/span&gt;(&lt;span style=&quot;color:#6aab73;&quot;&gt;&quot;,&quot;&lt;/span&gt;).&lt;span style=&quot;color:#57aaf7;font-style:italic;&quot;&gt;toFloatOrNull&lt;/span&gt;() ?: &lt;span style=&quot;color:#2aacb8;&quot;&gt;0f&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#2aacb8;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#2aacb8;&quot;&gt;                    &lt;/span&gt;&lt;span style=&quot;color:#cf8e6d;&quot;&gt;if &lt;/span&gt;(linearX != &lt;span style=&quot;color:#2aacb8;&quot;&gt;0f &lt;/span&gt;|| linearY != &lt;span style=&quot;color:#2aacb8;&quot;&gt;0f&lt;/span&gt;) {&lt;br&gt;                        &lt;span style=&quot;color:#7a7e85;&quot;&gt;// We scale the line so it stays inside the circle