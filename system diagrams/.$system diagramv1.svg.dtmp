yle=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;;&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt; // Position is unreachable&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;&amp;amp;nbsp; &amp;amp;nbsp; }&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;br&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;&amp;amp;nbsp; &amp;amp;nbsp; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #569cd6;&amp;quot;&amp;gt;float&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; cos_theta2_prime &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #d4d4d4;&amp;quot;&amp;gt;=&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; (L1&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #d4d4d4;&amp;quot;&amp;gt;*&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;L1 &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #d4d4d4;&amp;quot;&amp;gt;+&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; L2&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #d4d4d4;&amp;quot;&amp;gt;*&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;L2 &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #d4d4d4;&amp;quot;&amp;gt;-&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; D&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #d4d4d4;&amp;quot;&amp;gt;*&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;D) &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #d4d4d4;&amp;quot;&amp;gt;/&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; (&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #b5cea8;&amp;quot;&amp;gt;2&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: 