mpanion&lt;br&gt;                    .&lt;span style=&quot;color:#57aaf7;font-style:italic;&quot;&gt;fillMaxSize&lt;/span&gt;()&lt;br&gt;                    .&lt;span style=&quot;color:#57aaf7;font-style:italic;&quot;&gt;background&lt;/span&gt;(MaterialTheme.&lt;span style=&quot;color:#c77dbb;&quot;&gt;colors&lt;/span&gt;.&lt;span style=&quot;color:#c77dbb;&quot;&gt;background&lt;/span&gt;)&lt;br&gt;                    .&lt;span style=&quot;color:#57aaf7;font-style:italic;&quot;&gt;padding&lt;/span&gt;(&lt;span style=&quot;color:#2aacb8;&quot;&gt;8&lt;/span&gt;.&lt;span style=&quot;color:#c77dbb;font-style:italic;&quot;&gt;dp&lt;/span&gt;),  &lt;span style=&quot;color:#7a7e85;&quot;&gt;// Add some padding&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#7a7e85;&quot;&gt;                &lt;/span&gt;&lt;span style=&quot;color:#56c1d6;&quot;&gt;horizontalAlignment = &lt;/span&gt;Alignment.Companion.&lt;span style=&quot;color:#c77dbb;&quot;&gt;CenterHorizontally&lt;/span&gt;,&lt;br&gt;                &lt;span style=&quot;color:#56c1d6;&quot;&gt;verticalArrangement = &lt;/span&gt;Arrangement.&lt;span style=&quot;color:#c77dbb;&quot;&gt;Center&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#c77dbb;&quot;&gt;            &lt;/span&gt;) &lt;span style=&quot;font-weight:bold;&quot;&gt;{&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-weight:bold;&quot;&gt;                &lt;/span&gt;&lt;span style=&quot;color:#6bb38a;&quot;&gt;TimeText&lt;/span&gt;()&lt;br&gt;                &lt;span style=&quot;color:#6bb38a;&quot;&gt;Text&lt;/span&gt;(&lt;br&gt;                    &lt;span style=&quot;color:#56c1d6;&quot;&gt;modifier = &lt;/span&gt;Modifier.Companion.&lt;span style=&quot;color:#57aaf7;font-style:italic;&quot;&gt;fillMaxSize&lt;/span&gt;(),&lt;br&gt;                    &lt;span style=&quot;color:#56c1d6;&quot;&gt;textAlign = &lt;/span&gt;TextAlign.Companion.&lt;span style=&quot;color:#c77dbb;&quot;&gt;Center&lt;/span&gt;,&lt;br&gt;                    &lt;span style=&quo