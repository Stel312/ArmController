style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #9cdcfe;&amp;quot;&amp;gt;theta1_deg&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;, &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #569cd6;&amp;quot;&amp;gt;float&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #d4d4d4;&amp;quot;&amp;gt;*&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #9cdcfe;&amp;quot;&amp;gt;theta2_deg&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;, &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #569cd6;&amp;quot;&amp;gt;float&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #d4d4d4;&amp;quot;&amp;gt;*&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #9cdcfe;&amp;quot;&amp;gt;theta3_deg&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;) {&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;&amp;amp;nbsp; &amp;amp;nbsp; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt;// 1. Calculate the wrist position&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;&amp;amp;nbsp; &amp;amp;nbsp; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #569cd6;&amp;quot;&amp;gt;float&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; y_wrist &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #d4d4d4;&amp;quot;&amp;gt;=&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; y_target &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #d4d4d4;&amp;quot;&amp;gt;-&amp;lt;/span&amp;gt;&amp;lt;span style=&