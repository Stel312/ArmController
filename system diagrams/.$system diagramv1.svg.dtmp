lor:#c77dbb;">Red</span>,<br />                        <span style="color:#56c1d6;">center = </span>center,<br />                        <span style="color:#56c1d6;">radius = </span>radius,<br />                        <span style="color:#56c1d6;">style = </span>Stroke(<span style="color:#56c1d6;">width = </span><span style="color:#2aacb8;">2</span>.<span style="color:#c77dbb;font-style:italic;">dp</span>.<span style="color:#57aaf7;font-style:italic;">toPx</span>())<br />                    )<br /><br />                    <span style="color:#7a7e85;">// Logic to extract values for visualization<br /></span><span style="color:#7a7e85;">                    </span><span style="color:#cf8e6d;">val </span>linearX = linearText.<span style="color:#57aaf7;font-style:italic;">substringAfter</span>(<span style="color:#6aab73;">"Acc: X="</span>).<span style="color:#57aaf7;font-style:italic;">substringBefore</span>(<span style="color:#6aab73;">","</span>).<span style="color:#57aaf7;font-style:italic;">toFloatOrNull</span>() ?: <span style="color:#2aacb8;">0f<br /></span><span style="color:#2aacb8;">                    </span><span style="color:#cf8e6d;">val </span>linearY = linearText.<span style="color:#57aaf7;font-style:italic;">substringAfter</span>(<span style="color:#6aab73;">"Y="</span>).<span style="color:#57aaf7;font-style:italic;">substringBefore</span>(<span style="color:#6aab73;">","</span>).<span style="color:#57aaf7;font-style:italic;">toFloatOrNull</span>() ?: <span style="color:#2aacb8;">0f<br /></span><span style="color:#2aacb8;"><br /></span><span style="color:#2aacb8;">                    </span><span style="color:#cf8e6d;">if </span>(linearX != <span style="color:#2aacb8;">0f </span>|| linearY != <span style="color:#2aacb8;">0f</span>) {<br />                        <span style="color:#7a7e85;">// We scale the line so it stays inside the circle<br /></span><span style="color:#7a7e85;">                        </span><span style="color:#cf8e6d;">val </span>endX = center.<span style="color:#c77dbb;">x </span>+ (linearX * <span style="color:#2aacb8;">2</span>)<br />                        <span style="color:#cf8e6d;">val </span>endY = center.<span style="color:#c77dbb;">y </span>+ (linearY * <span style="color:#2aacb8;">2</span>)<br /><br />                        drawLine(<br />                            <span style="color:#56c1d6;">color = </span>Color.<span style="color:#c77dbb;">Cyan</span>,<br />                            <span style="color:#56c1d6;">start = </span>center,<br />                            <span style="color:#56c1d6;">end = </span><span style="font-style:italic;">Offset</span>(endX, endY),<br />                            <span style="color:#56c1d6;">strokeWidth = </span><span style="color:#2aacb8;">3</span>.<span style="color:#c77dbb;font-style:italic;">dp</span>.<span style="color:#57aaf7;font-style:italic;">toPx</span>()<br />                        )<br />                    }<br />                <span style="font-weight:bold;">}<br /></span><span style="font-weight:bold;">            }<br /></span><span style="font-weight:bold;">        }<br /></span><span style="font-weight:bold;">    }<br /></span>}</pre></div></div></div></div></foreignObject><text x="852" y="3629" fill="light-dark(#000000, #ffffff)" font-family="Helvetica" font-size="12px">package com.example.wearimu...</text></switch></g></g></a></g><g data-cell-id="K6mQ5VuKosuidy7TOubd-319"><g><image x="1790" y="2870" width="833" height="774" xlink:href="data:image/png;base64," preserveAspectRatio="none"/></g></g></g><g data-cell-id="K6mQ5VuKosuidy7TOubd-331"><g><image x="4452.5" y="1560" width="885" height="1200" xlink:href="data:image/svg+xml;base64," preserveAspectRatio="none"/></g></g><g data-cell-id="K6mQ5VuKosuidy7TOubd-338"><g transform="translate(0.5,0.5)"><path d="M 3530 550 L 3593.63 550" fill="none" stroke="#ffa300" stroke-miterlimit="10" pointer-events="stroke" style="stroke: rgb(255, 163, 0);"/><path d="M 3598.88 550 L 3591.8