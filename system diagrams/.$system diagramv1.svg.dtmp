r: #7ca668;&amp;quot;&amp;gt; &amp;amp;nbsp; &amp;amp;nbsp; &amp;amp;nbsp; &amp;amp;nbsp; &amp;amp;nbsp; &amp;amp;nbsp;// Duty value will be updated later (e.g., neutral)&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;&amp;amp;nbsp; &amp;amp;nbsp; &amp;amp;nbsp; &amp;amp;nbsp; .gpio_num &amp;amp;nbsp; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #d4d4d4;&amp;quot;&amp;gt;=&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #b5cea8;&amp;quot;&amp;gt;16&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;,&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;&amp;amp;nbsp; &amp;amp;nbsp; &amp;amp;nbsp; &amp;amp;nbsp; .speed_mode &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #d4d4d4;&amp;quot;&amp;gt;=&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; LEDC_SPEED_MODE,&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;&amp;amp;nbsp; &amp;amp;nbsp; &amp;amp;nbsp; &amp;amp;nbsp; .hpoint &amp;amp;nbsp; &amp;amp;nbsp; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #d4d4d4;&amp;quot;&amp;gt;=&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #b5cea8;&amp;quot;&amp;gt;0&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;,&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;&amp;amp;nbsp; &amp;amp;nbsp; &amp;amp;nbsp; &amp;amp;nbsp; .timer_sel &amp;amp;nbsp;&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #d4d4d4;&amp;quot;&amp;gt;=&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; LEDC_TIMER,&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;&amp;amp;nbsp; &amp;amp;nbsp; };&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;&amp;amp;nbsp; &amp;amp;nbsp; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #dcdcaa;&amp;quot;&amp;gt;ESP_ERROR_CHECK&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;(&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #dcdcaa;&amp;quot;&amp;gt;ledc_channel_config&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;(&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #d4d4d4;&amp;quot;&amp;gt;&amp;amp;amp;&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;ledc_channel_servo_3));&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;br&amp;gt;&amp;lt;br&amp;gt;&amp;lt;br&amp;gt;&amp;lt;br&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;&amp;amp;nbsp; &amp;amp;nbsp; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #dcdcaa;&amp;quot;&amp;gt;ESP_LOGI&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;(&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ce9178;&amp;quot;&amp;gt;&amp;quot;SERVO&amp;quot;&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;, &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ce9178;&amp;quot;&amp;gt;&amp;quot;PWM initialized on GPIO 18 (X), 19 (Y), 17 (Claw), 20 (ESC Left), and 21 (ESC Right)&amp;quot;&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;);&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;}&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;br&amp;gt;&amp;lt;br&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #569cd6;&amp;quot;&amp;gt;void&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #dcdcaa;&amp;quot;&amp;gt;set_servo_angle&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;(&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #4ec9b0;&amp;quot;&amp;gt;ledc_channel_t&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #9cdcfe;&amp;quot;&amp;gt;channel&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;, &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #569cd6;&amp;quot;&amp;gt;int&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #9cdcfe;&amp;quot;&amp;gt;angle&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;)&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;{&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;&amp;amp;nbsp; &amp;amp;nbsp; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt;// Step 1: Map angle to pulse width&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;&amp;amp;nbsp; &amp;amp;nbsp; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #569cd6;&amp;quot;&amp;gt;int&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; pulse_width_us &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #d4d4d4;&amp;quot;&amp;gt;=&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; SERVO_MIN_PULSEWIDTH &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #d4d4d4;&amp;quot;&amp;gt;+&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; ((SERVO_MAX_PULSEWIDTH &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #d4d4d4;&amp;quot;&amp;gt;-&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; SERVO_MIN_PULSEWIDTH) &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #d4d4d4;&amp;quot;&amp;gt;*&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; angle) &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #d4d4d4;&amp;quot;&amp;gt;/&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; SERVO_MAX_ANGLE;&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;br&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;&amp;amp;nbsp; &amp;amp;nbsp; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt;// Step 2: Convert pulse width to LEDC duty cycle value&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;&amp;amp;nbsp; &amp;amp;nbsp; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt;// Assuming a 50Hz frequency and 13-bit duty resolution (8192-1)&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;&amp;amp;nbsp; &amp;amp;nbsp; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt;// Period = 1,000,000 us / 50 Hz = 20,000 us&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;&amp;amp;nbsp; &amp;amp;nbsp; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #569cd6;&amp;quot;&amp;gt;uint32_t&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; duty_value &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #d4d4d4;&amp;quot;&amp;gt;=&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; (pulse_width_us &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #d4d4d4;&amp;quot;&amp;gt;*&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #b5cea8;&amp;quot;&amp;gt;8191&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;) &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #d4d4d4;&amp;quot;&amp;gt;/&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #b5cea8;&amp;quot;&amp;gt;20000&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;;&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;br&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;&amp;amp;nbsp; &amp;amp;nbsp; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt;// Update the PWM duty cycle&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;&amp;amp;nbsp; &amp;amp;nbsp; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #dcdcaa;&amp;quot;&amp;gt;ESP_ERROR_CHECK&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;(&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #dcdcaa;&amp;quot;&amp;gt;ledc_set_duty&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;(LEDC_SPEED_MODE, channel, duty_value));&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;&amp;amp;nbsp; &amp;amp;nbsp; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #dcdcaa;&amp;quot;&amp;gt;ESP_ERROR_CHECK&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;(&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #dcdcaa;&amp;quot;&amp;gt;ledc_update_duty&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;(LEDC_SPEED_MODE, channel));&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;}&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;br&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt;/*&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt;&amp;amp;nbsp;* Update PWM duty cycle from incoming X and Y angles.&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt;&amp;amp;nbsp;*&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt;&amp;amp;nbsp;* The incoming x and y values are specified in hundredths of a degree.&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt;&amp;amp;nbsp;* (e.g., 9000 means 90.00°). We clamp each value to a maximum of 18000 (i.e., 180°).&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt;&amp;amp;nbsp;*&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt;&amp;amp;nbsp;* The typical servo expects a pulse width from ~1 ms (min) to ~2 ms (max)&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt;&amp;amp;nbsp;* over a 20 ms period (50 Hz). With a 13-bit resolution (max 8191),&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt;&amp;amp;nbsp;* these translate roughly into duty values of about 410 (1 ms) and 819 (2 ms).&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt;&amp;amp;nbsp;*/&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #569cd6;&amp;quot;&amp;gt;void&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #dcdcaa;&amp;quot;&amp;gt;update_xy_servo_positions&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;(&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #569cd6;&amp;quot;&amp;gt;uint16_t&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #9cdcfe;&amp;quot;&amp;gt;x_value&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;, &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #569cd6;&amp;quot;&amp;gt;uint16_t&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #9cdcfe;&amp;quot;&amp;gt;y_value&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;)&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;{&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;&amp;amp;nbsp; &amp;amp;nbsp; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #dcdcaa;&amp;quot;&amp;gt;set_servo_angle&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;(LEDC_CHANNEL_X, x_value);&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;&amp;amp;nbsp; &amp;amp;nbsp; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #dcdcaa;&amp;quot;&amp;gt;set_servo_angle&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;(LEDC_CHANNEL_Y, y_value);&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;}&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;br&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt;/*&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt;&amp;amp;nbsp;* Update PWM duty cycle for the claw from incoming angle.&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt;&amp;amp;nbsp;*&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt;&amp;amp;nbsp;* The incoming claw_value is specified in hundredths of a degree.&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt;&amp;amp;nbsp;* (e.g., 9000 means 90.00°). We clamp the value to a maximum of 18000 (i.e., 180°).&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt;&amp;amp;nbsp;*&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt;&amp;amp;nbsp;* The duty cycle range for the claw might be different from the X/Y servos.&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt;&amp;amp;nbsp;* Adjust min_duty_claw and max_duty_claw as needed for your specific claw servo.&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt;&amp;amp;nbsp;*/&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #569cd6;&amp;quot;&amp;gt;void&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #dcdcaa;&amp;quot;&amp;gt;update_claw_position&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;(&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #569cd6;&amp;quot;&amp;gt;uint16_t&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #9cdcfe;&amp;quot;&amp;gt;claw_value&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;)&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;{&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;&amp;amp;nbsp; &amp;amp;nbsp; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #dcdcaa;&amp;quot;&amp;gt;set_servo_angle&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;(LEDC_CHANNEL_CLAW, claw_value);&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;}&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;br&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt;/*&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt;&amp;amp;nbsp;* Update PWM duty cycles for two ESCs (left and right).&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt;&amp;amp;nbsp;*&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt;&amp;amp;nbsp;* The incoming values (left_speed, right_speed) are expected to be uint16_t.&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt;&amp;amp;nbsp;* A common range for ESCs is 1000us (stopped) to 2000us (full throttle),&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt;&amp;amp;nbsp;* with 1500us being neutral. With 13-bit resolution (8191 max duty),&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt;&amp;amp;nbsp;* 1000us is approx. 410, 1500us is approx. 614, 2000us is approx. 819.&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt;&amp;amp;nbsp;*&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt;&amp;amp;nbsp;* For simplicity, we&amp;#39;ll map an input range of 0-18000 (similar to servo angles)&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt;&amp;amp;nbsp;* where 0 is min, 9000 is neutral, and 18000 is max. You will need to calibrate&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt;&amp;amp;nbsp;* these values precisely for your ESCs.&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt;&amp;amp;nbsp;*/&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #569cd6;&amp;quot;&amp;gt;void&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #dcdcaa;&amp;quot;&amp;gt;update_esc_speeds&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;(&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #569cd6;&amp;quot;&amp;gt;uint16_t&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #9cdcfe;&amp;quot;&amp;gt;left_speed&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;, &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #569cd6;&amp;quot;&amp;gt;uint16_t&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #9cdcfe;&amp;quot;&amp;gt;right_speed&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;)&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;{&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;&amp;amp;nbsp; &amp;amp;nbsp; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt;// Clamp values to the expected range if necessary&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;&amp;amp;nbsp; &amp;amp;nbsp; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #c586c0;&amp;quot;&amp;gt;if&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; (left_speed &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #d4d4d4;&amp;quot;&amp;gt;&amp;amp;gt;&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #b5cea8;&amp;quot;&amp;gt;18000&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;) {&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;&amp;amp;nbsp; &amp;amp;nbsp; &amp;amp;nbsp; &amp;amp;nbsp; left_speed &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #d4d4d4;&amp;quot;&amp;gt;=&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #b5cea8;&amp;quot;&amp;gt;18000&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;;&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;&amp;amp;nbsp; &amp;amp;nbsp; }&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;&amp;amp;nbsp; &amp;amp;nbsp; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #c586c0;&amp;quot;&amp;gt;if&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; (right_speed &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #d4d4d4;&amp;quot;&amp;gt;&amp;amp;gt;&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #b5cea8;&amp;quot;&amp;gt;18000&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;) {&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;&amp;amp;nbsp; &amp;amp;nbsp; &amp;amp;nbsp; &amp;amp;nbsp; right_speed &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #d4d4d4;&amp;quot;&amp;gt;=&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #b5cea8;&amp;quot;&amp;gt;18000&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;;&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;&amp;amp;nbsp; &amp;amp;nbsp; }&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;br&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;&amp;amp;nbsp; &amp;amp;nbsp; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt;// ESC pulse width typically from 1000us to 2000us&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;&amp;amp;nbsp; &amp;amp;nbsp; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt;// With 13-bit resolution (period = 20ms = 20000us)&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;&amp;amp;nbsp; &amp;amp;nbsp; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt;// Min duty (~1000us) = (1000us / 20000us) * 8191 = 409.55 -&amp;amp;gt; ~410&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;&amp;amp;nbsp; &amp;amp;nbsp; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt;// Mid duty (~1500us) = (1500us / 20000us) * 8191 = 614.325 -&amp;amp;gt; ~614&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;&amp;amp;nbsp; &amp;amp;nbsp; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt;// Max duty (~2000us) = (2000us / 20000us) * 8191 = 819.1 -&amp;amp;gt; ~819&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;&amp;amp;nbsp; &amp;amp;nbsp; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #569cd6;&amp;quot;&amp;gt;const&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #569cd6;&amp;quot;&amp;gt;uint32_t&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; esc_min_duty &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #d4d4d4;&amp;quot;&amp;gt;=&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #b5cea8;&amp;quot;&amp;gt;410&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;;&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt; // Corresponds to ~1ms pulse&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;&amp;amp;nbsp; &amp;amp;nbsp; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #569cd6;&amp;quot;&amp;gt;const&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #569cd6;&amp;quot;&amp;gt;uint32_t&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; esc_max_duty &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #d4d4d4;&amp;quot;&amp;gt;=&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #b5cea8;&amp;quot;&amp;gt;819&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;;&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt; // Corresponds to ~2ms pulse&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;br&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;&amp;amp;nbsp; &amp;amp;nbsp; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #7ca668;&amp;quot;&amp;gt;// Map input (0-18000) to ESC duty cycle range (410-819)&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;&amp;amp;nbsp; &amp;amp;nbsp; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #569cd6;&amp;quot;&amp;gt;uint32_t&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; duty_left &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #d4d4d4;&amp;quot;&amp;gt;=&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; esc_min_duty &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #d4d4d4;&amp;quot;&amp;gt;+&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; ((esc_max_duty &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #d4d4d4;&amp;quot;&amp;gt;-&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; esc_min_duty) &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #d4d4d4;&amp;quot;&amp;gt;*&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; left_speed) &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #d4d4d4;&amp;quot;&amp;gt;/&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #b5cea8;&amp;quot;&amp;gt;18000&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;;&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;&amp;amp;nbsp; &amp;amp;nbsp; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #569cd6;&amp;quot;&amp;gt;uint32_t&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; duty_right &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #d4d4d4;&amp;quot;&amp;gt;=&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; esc_min_duty &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #d4d4d4;&amp;quot;&amp;gt;+&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; ((esc_max_duty &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #d4d4d4;&amp;quot;&amp;gt;-&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; esc_min_duty) &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #d4d4d4;&amp;quot;&amp;gt;*&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; right_speed) &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #d4d4d4;&amp;quot;&amp;gt;/&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #b5cea8;&amp;quot;&amp;gt;18000&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;;&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;br&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;&amp;amp;nbsp; &amp;amp;nbsp; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #dcdcaa;&amp;quot;&amp;gt;ESP_LOGI&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;(&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ce9178;&amp;quot;&amp;gt;&amp;quot;ESC&amp;quot;&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;, &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ce9178;&amp;quot;&amp;gt;&amp;quot;Updating ESCs: Left duty = %u, Right duty = %u for speeds (%u, %u)&amp;quot;&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;,&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;&amp;amp;nbsp; &amp;amp;nbsp; &amp;amp;nbsp; &amp;amp;nbsp; &amp;amp;nbsp; &amp;amp;nbsp; &amp;amp;nbsp;(&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #569cd6;&amp;quot;&amp;gt;unsigned&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #569cd6;&amp;quot;&amp;gt;int&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;)duty_left, (&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #569cd6;&amp;quot;&amp;gt;unsigned&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt; &amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #569cd6;&amp;quot;&amp;gt;int&amp;lt;/span&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;)duty_right, left_speed, right_speed);&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;&amp;lt;br&amp;gt;&amp;lt;div&amp;gt;&amp;lt;span style=&amp;quot;color: #ffffff;&amp;quot;&amp;gt;&amp;amp;nbs