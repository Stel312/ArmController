uot;&gt;toFloatOrNull&lt;/span&gt;() ?: &lt;span style=&quot;color:#2aacb8;&quot;&gt;0f&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#2aacb8;&quot;&gt;                    &lt;/span&gt;&lt;span style=&quot;color:#cf8e6d;&quot;&gt;val &lt;/span&gt;accY =&lt;br&gt;                        accData.&lt;span style=&quot;color:#57aaf7;font-style:italic;&quot;&gt;substringAfter&lt;/span&gt;(&lt;span style=&quot;color:#6aab73;&quot;&gt;&quot;Y=&quot;&lt;/span&gt;).&lt;span style=&quot;color:#57aaf7;font-style:italic;&quot;&gt;substringBefore&lt;/span&gt;(&lt;span style=&quot;color:#6aab73;&quot;&gt;&quot;,&quot;&lt;/span&gt;).&lt;span style=&quot;color:#57aaf7;font-style:italic;&quot;&gt;toFloatOrNull&lt;/span&gt;() ?: &lt;span style=&quot;color:#2aacb8;&quot;&gt;0f&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#2aacb8;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#2aacb8;&quot;&gt;                    &lt;/span&gt;&lt;span style=&quot;color:#cf8e6d;&quot;&gt;if &lt;/span&gt;(accX != &lt;span style=&quot;color:#2aacb8;&quot;&gt;0f &lt;/span&gt;&amp;amp;&amp;amp; accY != &lt;span style=&quot;color:#2aacb8;&quot;&gt;0f&lt;/span&gt;) {&lt;br&gt;                        &lt;span style=&quot;color:#cf8e6d;&quot;&gt;val &lt;/span&gt;endX =&lt;br&gt;                            center.&lt;span style=&quot;color:#c77dbb;&quot;&gt;x &lt;/span&gt;+ accX * &lt;span style=&quot;color:#2aacb8;&quot;&gt;20 &lt;/span&gt;&lt;span style=&quot;color:#7a7e85;&quot;&gt;// Scale the accelerometer values for visualization&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#7a7e85;&quot;&gt;                        &lt;/span&gt;&lt;span style=&quot;color:#cf8e6d;&quot;&gt;val &lt;/span&gt;endY = center.&lt;span style=&quot;color:#c77dbb;&quot;&gt;y &lt;/span&gt;+ accY * &lt;span style=&quot;color:#2aacb8;&quot;&gt;20&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#2aacb8;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#2aacb8;&quot;&gt;                        &lt;/span&